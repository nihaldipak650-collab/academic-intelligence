  "research_directions_plain_language": [
    {
      "term_original": "遗传性疾病致病基因发现",
      "explanation_zh": "依据官方方向，可把这一主线理解为从家系、患者或变异数据中寻找候选致病基因，再用正式研究证据评估其与疾病表型的关系。",
      "undergraduate_meaning": "需要区分候选发现、遗传证据、功能验证和临床解释，不能把单一关联直接等同于致病机制。",
      "evidence_ids": [
        "E1",
        "E2",
        "E3",
        "E4",
        "E6",
        "E11"
      ],
      "confidence": "Medium",
      "evidence_lane": "ai_synthesis"
    },
    {
      "term_original": "高度近视遗传机制",
      "explanation_zh": "官方主页明确将高度近视列为重点方向；GLRA2论文提供了人群遗传证据与小鼠功能研究相连接的正式案例。",
      "undergraduate_meaning": "可从基因变异、眼部表型和模型验证三层证据理解该方向。",
      "evidence_ids": [
        "E3",
        "E6",
        "E11"
      ],
      "confidence": "Medium",
      "evidence_lane": "ai_synthesis"
    },
    {
      "term_original": "儿童自闭症相关基因功能",
      "explanation_zh": "官方主页将儿童自闭症列为重点方向；CNTN4论文展示了风险基因与树突、树突棘形成等神经细胞表型之间的研究联系。",
      "undergraduate_meaning": "需要把人类遗传关联与神经细胞功能结果分别核验。",
      "evidence_ids": [
        "E5",
        "E6"
      ],
      "confidence": "Medium",
      "evidence_lane": "ai_synthesis"
    },
    {
      "term_original": "跨疾病罕见变异与功能验证",
      "explanation_zh": "官网代表论文还涉及PITX2调控区、TRMT2B和NF1，说明公开研究线索覆盖非编码调控、神经退行性疾病与体细胞变异等不同遗传问题。",
      "undergraduate_meaning": "不同疾病与样本类型的方法不能机械互换，页面只保留共同的遗传证据链框架。",
      "evidence_ids": [
        "E1",
        "E2",
        "E4",
        "E6"
      ],
      "confidence": "Medium",
      "evidence_lane": "ai_synthesis"
    }
  ],

  "research_directions_original": [
    {
      "text": "综合运用冷冻电镜、X射线晶体衍射、核磁共振、生物化学和细胞生物学研究生物大分子机器的结构与功能。",
      "evidence_status": "verified",
      "confidence": "High",
      "source_urls": [
        "https://life.csu.edu.cn/info/1042/2556.htm"
      ],
      "evidence_ids": [
        "E6"
      ],
      "evidence_lane": "public_fact",
      "no_evidence_reason": null
    },
    {
      "text": "研究细胞周期相关蛋白质机器的分子结构与工作机理，以及遗传突变导致相关疾病的机制。",
      "evidence_status": "verified",
      "confidence": "High",
      "source_urls": [
        "https://life.csu.edu.cn/info/1042/2556.htm"
      ],
      "evidence_ids": [
        "E6"
      ],
      "evidence_lane": "public_fact",
      "no_evidence_reason": null
    },
    {
      "text": "研究病原微生物与宿主相互作用的分子机制。",
      "evidence_status": "verified",
      "confidence": "High",
      "source_urls": [
        "https://life.csu.edu.cn/info/1042/2556.htm"
      ],
      "evidence_ids": [
        "E6"
      ],
      "evidence_lane": "public_fact",
      "no_evidence_reason": null
    },
    {
      "text": "以蛋白质结构为基础，针对神经退行性疾病、心脏病等相关重要蛋白靶点开展小分子抑制剂筛选和优化。",
      "evidence_status": "verified",
      "confidence": "High",
      "source_urls": [
        "https://life.csu.edu.cn/info/1042/2556.htm"
      ],
      "evidence_ids": [
        "E6"
      ],
      "evidence_lane": "public_fact",
      "no_evidence_reason": null
    }
  ],
  "research_directions_plain_language": [
    {
      "term_original": "蛋白质机器与高尔基体重建",
      "explanation_zh": "基于公开证据，官方方向强调生物大分子机器；VCPIP1–P97/VCP论文提供了一个具体案例，说明结构、生化和细胞证据如何连接复合体组织、构象调控与有丝分裂后高尔基体重建。",
      "undergraduate_meaning": "适合先学习“结构—界面—活性—细胞表型”的分层证据链，不把单一结构图直接等同于完整细胞机制。",
      "evidence_ids": [
        "E1",
        "E6"
      ],
      "confidence": "Medium",
      "evidence_lane": "ai_synthesis"
    },
    {
      "term_original": "细菌抗噬菌体防御与噬菌体反防御",
      "explanation_zh": "DSR2、ShosTA和Sofic论文分别展示NADase、防御型毒素—抗毒素和AMPylation相关系统的结构与调控。",
      "undergraduate_meaning": "可比较不同防御系统的触发信号、毒性输出、抗毒或抑制机制以及用于验证的结构和功能实验。",
      "evidence_ids": [
        "E2",
        "E3",
        "E4",
        "E6"
      ],
      "confidence": "Medium",
      "evidence_lane": "ai_synthesis"
    },
    {
      "term_original": "结构驱动的疾病靶点与小分子研究",
      "explanation_zh": "官方主页提出基于蛋白质结构开展疾病相关靶点的小分子筛选和优化。",
      "undergraduate_meaning": "本科阶段可先从结构口袋、突变位点和已公开活性证据的整理入手；公开资料不能证明当前具体项目或本科生准入。",
      "evidence_ids": [
        "E6"
      ],
      "confidence": "Medium",
      "evidence_lane": "ai_synthesis"
    }

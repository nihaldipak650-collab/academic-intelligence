{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-intelligence.local/schemas/evidence-manifest-schema-v1.0.4.json",
  "title": "Academic Intelligence Typed Evidence Manifest v1.0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "advisor_id", "candidate_evidence"],
  "properties": {
    "schema_version": {"const": "1.0.4"},
    "advisor_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "source_scope": {"type": "string", "minLength": 1},
    "candidate_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate_evidence"}
    }
  },
  "$defs": {
    "evidence_id": {"type": "string", "pattern": "^E[1-9][0-9]*$"},
    "candidate_statuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["candidate", "adopted", "excluded", "duplicate_candidate", "identity_pending"]}
    },
    "repository_source_ref": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:\\\\|/).+$"},
    "supported_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "publication_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id", "evidence_type", "source_url", "source_authority",
        "candidate_statuses", "reason", "supported_fields", "repository_source_ref",
        "last_verified_at", "notes", "title", "publication_year", "doi",
        "source_type", "author_position", "is_co_first", "is_corresponding",
        "identity_verified", "version_group"
      ],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/evidence_id"},
        "evidence_type": {"const": "publication"},
        "source_url": {"type": "string", "format": "uri"},
        "source_authority": {"enum": ["publication", "researcher_api", "official_institution", "official_advisor", "official_lab"]},
        "candidate_statuses": {"$ref": "#/$defs/candidate_statuses"},
        "reason": {"type": ["string", "null"]},
        "supported_fields": {"$ref": "#/$defs/supported_fields"},
        "repository_source_ref": {"$ref": "#/$defs/repository_source_ref"},
        "last_verified_at": {"type": ["string", "null"], "format": "date"},
        "notes": {"type": ["string", "null"]},
        "title": {"type": "string", "minLength": 1},
        "publication_year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2100},
        "doi": {"type": ["string", "null"], "pattern": "^10\\.[0-9]{4,9}/\\S+$"},
        "source_type": {"enum": ["journal_article", "preprint", "conference", "review", "other"]},
        "author_position": {"enum": ["first", "middle", "last", "unknown"]},
        "is_co_first": {"type": ["boolean", "null"]},
        "is_corresponding": {"type": ["boolean", "null"]},
        "identity_verified": {"type": "boolean"},
        "version_group": {"type": ["string", "null"]}
      }
    },
    "official_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "fact_text", "fact_category", "supported_public_fields"],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^F[1-9][0-9]*$"},
        "fact_text": {"type": "string", "minLength": 1},
        "fact_category": {"enum": ["research_direction", "research_method", "research_platform", "model_organism", "professional_title", "supervisor_type", "official_contact", "representative_publication_seed", "other_official_fact"]},
        "source_section": {"type": "string", "minLength": 1},
        "source_anchor": {"type": "string", "minLength": 1},
        "supported_public_fields": {"$ref": "#/$defs/supported_fields"}
      }
    },
    "official_profile_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id", "evidence_type", "source_url", "source_authority",
        "candidate_statuses", "reason", "supported_fields", "repository_source_ref",
        "last_verified_at", "notes", "page_title", "profile_name", "institution",
        "school_or_department", "extracted_facts"
      ],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/evidence_id"},
        "evidence_type": {"const": "official_profile"},
        "source_url": {"type": "string", "format": "uri"},
        "source_authority": {"enum": ["official_institution", "official_advisor", "official_lab"]},
        "candidate_statuses": {"$ref": "#/$defs/candidate_statuses"},
        "reason": {"type": ["string", "null"]},
        "supported_fields": {"$ref": "#/$defs/supported_fields"},
        "repository_source_ref": {"$ref": "#/$defs/repository_source_ref"},
        "last_verified_at": {"type": ["string", "null"], "format": "date"},
        "notes": {"type": ["string", "null"]},
        "page_title": {"type": "string", "minLength": 1},
        "profile_name": {"type": "string", "minLength": 1},
        "institution": {"type": "string", "minLength": 1},
        "school_or_department": {"type": "string", "minLength": 1},
        "extracted_facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/official_fact"}}
      }
    },
    "candidate_evidence": {
      "oneOf": [
        {"$ref": "#/$defs/publication_evidence"},
        {"$ref": "#/$defs/official_profile_evidence"}
      ]
    }
  }
}

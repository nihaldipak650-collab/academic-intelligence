  "research_directions_original": [
    {
      "text": "利用基因组学和遗传统计解析孤独症遗传结构，鉴定风险变异并关注非编码变异及其调控机制。",
      "evidence_status": "verified",
      "confidence": "High",
      "source_urls": [
        "https://life.csu.edu.cn/info/1042/2565.htm"
      ],
      "evidence_ids": [
        "E6"
      ],
      "evidence_lane": "public_fact",
      "no_evidence_reason": null
    },
    {
      "text": "利用医学遗传学和临床表型组学研究孤独症及相关神经发育障碍的高风险基因、基因型-表型关系与分子分型。",
      "evidence_status": "verified",
      "confidence": "High",
      "source_urls": [
        "https://life.csu.edu.cn/info/1042/2565.htm"
      ],
      "evidence_ids": [
        "E6"
      ],
      "evidence_lane": "public_fact",
      "no_evidence_reason": null
    },
    {
      "text": "综合分子生物学、细胞生物学、神经生物学和功能基因组学研究共性分子致病机制。",
      "evidence_status": "verified",
      "confidence": "High",
      "source_urls": [
        "https://life.csu.edu.cn/info/1042/2565.htm"
      ],
      "evidence_ids": [
        "E6"
      ],
      "evidence_lane": "public_fact",
      "no_evidence_reason": null
    },
    {
      "text": "构建神经发育障碍基因组信息解读系统，研究早期诊断与风险预警应用。",
      "evidence_status": "verified",
      "confidence": "High",
      "source_urls": [
        "https://life.csu.edu.cn/info/1042/2565.htm"
      ],
      "evidence_ids": [
        "E6"
      ],
      "evidence_lane": "public_fact",
      "no_evidence_reason": null
    }
  ],
  "research_directions_plain_language": [
    {
      "term_original": "孤独症遗传结构与分子分型",
      "explanation_zh": "依据官方方向和采用论文，可把这一主题理解为从患者队列与变异数据中寻找风险基因，并比较基因型、临床表型和分子机制之间的联系。",
      "undergraduate_meaning": "需要区分变异发现、统计关联、分子分型和功能验证四类证据。",
      "evidence_ids": [
        "E1",
        "E4",
        "E5",
        "E6"
      ],
      "confidence": "Medium",
      "evidence_lane": "ai_synthesis"
    },
    {
      "term_original": "应激颗粒与RNA调控机制",
      "explanation_zh": "基于公开论文，UBAP2L相关应激颗粒网络、PABPC1和CSDE1等RNA结合或翻译调控因子可连接神经发生、突触与神经发育障碍表型。",
      "undergraduate_meaning": "可先从“变异—RNA/蛋白过程—细胞表型—疾病表型”的证据链入手。",
      "evidence_ids": [
        "E2",
        "E3",
        "E5"
      ],
      "confidence": "Medium",
      "evidence_lane": "ai_synthesis"
    },
    {
      "term_original": "从候选基因到功能机制",
      "explanation_zh": "依据GIGYF1、NCKAP1等论文，研究可能把人群遗传证据与细胞、神经元或动物模型中的功能读出连接起来。",
      "undergraduate_meaning": "同一基因的统计证据、细胞机制和动物行为不能相互替代，需要分别核验。",
      "evidence_ids": [
        "E1",
        "E4"
      ],
      "confidence": "Medium",
      "evidence_lane": "ai_synthesis"
    }
  ],

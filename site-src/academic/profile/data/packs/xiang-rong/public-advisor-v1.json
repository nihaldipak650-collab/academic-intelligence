  "research_directions_original": [
    {
      "text": "研究病原微生物感染、肿瘤、原发性多囊肾等疾病发生过程中，相关细胞器、细胞信号转导、细胞物质运输和细胞代谢等细胞结构与功能异常。",
      "evidence_status": "verified",
      "confidence": "High",
      "source_urls": [
        "https://life.csu.edu.cn/info/1042/2515.htm"
      ],
      "evidence_ids": [
        "E6"
      ],
      "evidence_lane": "public_fact",
      "no_evidence_reason": null
    },
    {
      "text": "运用新一代测序、色谱、细胞免疫等技术，从基因、分子、细胞、模式动物及人体层面研究动脉粥样硬化、高血脂、心肌病等心血管相关疾病机制，并结合临床筛选早期检测诊断分子和预后标志物。",
      "evidence_status": "verified",
      "confidence": "High",
      "source_urls": [
        "https://life.csu.edu.cn/info/1042/2515.htm"
      ],
      "evidence_ids": [
        "E6"
      ],
      "evidence_lane": "public_fact",
      "no_evidence_reason": null
    }
  ],
